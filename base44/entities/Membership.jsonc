{
  "name": "Membership",
  "type": "object",
  "visibility": "Authenticated",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "user_full_name": {
      "type": "string",
      "description": "Copied from User.full_name for display purposes"
    },
    "user_email": {
      "type": "string",
      "description": "Copied from User.email for display purposes"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "role_id": {
      "type": "string",
      "description": "Reference to Role entity"
    },
    "is_owner": {
      "type": "boolean",
      "default": false,
      "description": "True for tenant creator (can delete company, manage members)"
    },
    "is_platform_admin": {
      "type": "boolean",
      "default": false,
      "description": "True for platform super-admin accounts (hidden from regular users)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Membership status"
    },
    "invited_by": {
      "type": "string",
      "description": "User ID who invited this member, null for self-registered owners"
    }
  },
  "required": [
    "user_id",
    "company_id",
    "role_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": "true"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": "true"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": "true"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": "true"
          }
        }
      ]
    }
  }
}